# === Supabase Configuration ===
GCR_SUPABASE_URL=your_supabase_url
GCR_SUPABASE_SERVICE_KEY=your_service_key

# === Email Configuration (Brevo) ===
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@gulfcoastcruise.com
FROM_NAME=Gulf Coast Radar

# === Application URLs ===
APP_URL=https://gcr-unified.vercel.app
API_BASE_URL=https://gcr-api-clean.vercel.app

# === JWT Configuration ===
JWT_SECRET=your_jwt_secret_key_here

# === Feature Flags ===
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════
# COMPOSIO — the App Store
# ═══════════════════════════════════════════════════════════════════════════
#
# ONE variable is required. The other three have working defaults and only
# exist because Composio has moved its host and version more than once, and a
# hardcoded one is how an integration quietly dies.
#
# Get the key from the Composio dashboard: Settings → API Keys.
# NOT the Getting Started wizard — that is for building an AI agent, which is
# a different product. This platform calls the REST API directly and needs no
# SDK, no framework and no provider.
#
# Free tier is 20,000 tool calls a month. Billing is per CALL, not per
# connected business — connecting 500 businesses costs nothing extra.
COMPOSIO_API_KEY=

# Defaults are correct as of the v3 port. Override only if Composio moves.
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_API_VERSION=v3

# Where Composio returns a business after they authorise a tool. Optional —
# without it Composio uses the default configured on your project.
# COMPOSIO_REDIRECT_URL=

# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE BUSINESS PROFILE
# ═══════════════════════════════════════════════════════════════════════════
#
# The one integration Composio does not cover, and the only one that proves a
# business is real: Google makes them verify the address by postcard, phone or
# video before they can control the profile.
#
# Needs a Google Cloud project with the Business Profile APIs enabled. That
# access has an approval process measured in weeks, so apply before you need
# it. Until all four are set the routes answer 503 with what is missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gcr-api-clean.vercel.app/api/google-business/callback

# Encrypts OAuth tokens at rest (AES-256-GCM). 32 bytes of hex — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored token unreadable and every business has to
# reconnect, so set it once and keep it.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Where a business lands after the Google callback.
# DASHBOARD_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# BUSINESS DASHBOARD
# ═══════════════════════════════════════════════════════════════════════════
#
# Where an admin's invite link sends a business to set their password. Without
# this, invites keep pointing at the old cybercheck-login claim page — so
# setting it is what moves the flow over, rather than a deploy silently
# redirecting invites that are already out.
# DASHBOARD_ACCEPT_URL=https://<your-business-dashboard>/

# Login label domain for phone-only accounts. `.invalid` is reserved by
# RFC 2606 and can never be a real domain; nothing is ever sent to it.
# BUSINESS_PHONE_LOGIN_DOMAIN=business.invalid

# How far inland the GCR service area reaches, in miles from the coastline
# anchors in lib/serviceArea.js.
# GCR_SERVICE_AREA_MILES=25
