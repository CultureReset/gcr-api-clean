# === Supabase Configuration ===
GCR_SUPABASE_URL=your_supabase_url
GCR_SUPABASE_SERVICE_KEY=your_service_key

# === Email Configuration (Brevo) ===
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@gulfcoastcruise.com
FROM_NAME=Gulf Coast Radar

# === Application URLs ===
APP_URL=https://gcr-unified.vercel.app
API_BASE_URL=https://gcr-api-clean.vercel.app

# === JWT Configuration ===
JWT_SECRET=your_jwt_secret_key_here

# === Sendblue (standalone inbound parser only) ===
# Used by routes/inbound-parser.js + utils/sendblue.js. Nothing else reads these.
SENDBLUE_KEY_ID=
SENDBLUE_SECRET=
# Optional — only if you send from a specific Sendblue number
SENDBLUE_FROM_NUMBER=

# Shared secret your email provider must send as ?secret= or x-webhook-secret
# on POST /api/inbound/email. Leave blank to accept unauthenticated posts.
INBOUND_PARSER_SECRET=

# === Feature Flags ===
NODE_ENV=production
