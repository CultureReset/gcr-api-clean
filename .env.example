# === Supabase Configuration ===
GCR_SUPABASE_URL=your_supabase_url
GCR_SUPABASE_SERVICE_KEY=your_service_key

# === Email Configuration (Brevo) ===
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@gulfcoastcruise.com
FROM_NAME=Gulf Coast Radar

# === Application URLs ===
APP_URL=https://gcr-unified.vercel.app
API_BASE_URL=https://gcr-api-clean.vercel.app

# === JWT Configuration ===
JWT_SECRET=your_jwt_secret_key_here

# === Scheduled endpoints (vercel.json crons) ===
# Every cron route (lib/cronAuth.js) requires this in a header: Vercel sends
# `Authorization: Bearer <CRON_SECRET>`; `x-cron-secret` is accepted too. It is
# never read from the URL. Unset, every scheduled endpoint answers 503.
CRON_SECRET=

# === Feature Flags ===
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════
# COMPOSIO — the App Store
# ═══════════════════════════════════════════════════════════════════════════
#
# ONE variable is required. The other three have working defaults and only
# exist because Composio has moved its host and version more than once, and a
# hardcoded one is how an integration quietly dies.
#
# Get the key from the Composio dashboard: Settings → API Keys.
# NOT the Getting Started wizard — that is for building an AI agent, which is
# a different product. This platform calls the REST API directly and needs no
# SDK, no framework and no provider.
#
# Free tier is 20,000 tool calls a month. Billing is per CALL, not per
# connected business — connecting 500 businesses costs nothing extra.
COMPOSIO_API_KEY=

# Defaults are correct as of the v3 port. Override only if Composio moves.
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_API_VERSION=v3

# Where Composio returns a business after they authorise a tool. Optional —
# without it Composio uses the default configured on your project.
# COMPOSIO_REDIRECT_URL=

# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE BUSINESS PROFILE
# ═══════════════════════════════════════════════════════════════════════════
#
# The one integration Composio does not cover, and the only one that proves a
# business is real: Google makes them verify the address by postcard, phone or
# video before they can control the profile.
#
# Needs a Google Cloud project with the Business Profile APIs enabled. That
# access has an approval process measured in weeks, so apply before you need
# it. Until all four are set the routes answer 503 with what is missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gcr-api-clean.vercel.app/api/google-business/callback

# Google OAuth tokens are now encrypted by lib/secretBox.js (key from
# NEXTGENT_SECRETS_KEY — see below).
# OAUTH_TOKEN_ENCRYPTION_KEY is only READ: tokens stored before the switch are
# in the old format under this 32-byte hex key, and each is re-stored with
# secretBox the next time its access token refreshes. Keep it set until every
# oauth_tokens row for provider google_business starts with "v1.", then remove.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Where a business lands after the Google callback.
# DASHBOARD_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# BUSINESS DASHBOARD
# ═══════════════════════════════════════════════════════════════════════════
#
# Where an admin's invite link sends a business to set their password. Without
# this, invites keep pointing at the old cybercheck-login claim page — so
# setting it is what moves the flow over, rather than a deploy silently
# redirecting invites that are already out.
# DASHBOARD_ACCEPT_URL=https://<your-business-dashboard>/

# Login label domain for phone-only accounts. `.invalid` is reserved by
# RFC 2606 and can never be a real domain; nothing is ever sent to it.
# BUSINESS_PHONE_LOGIN_DOMAIN=business.invalid

# How far inland the GCR service area reaches, in miles from the coastline
# anchors in lib/serviceArea.js.
# GCR_SERVICE_AREA_MILES=25

# ═══════════════════════════════════════════════════════════════════════════
# NEXT GENT — Paperclip link (CONTRACT §1, §3, §4)
# ═══════════════════════════════════════════════════════════════════════════
#
# Paperclip signs a short-lived business token per company; this API checks it
# against Paperclip's published keys, then maps company_id -> business through
# company_links (sql/nextgent_link.sql).
#
# The `iss` Paperclip puts in its tokens (its PAPERCLIP_PUBLIC_URL).
PAPERCLIP_ISSUER=
# Paperclip's public keys: <PAPERCLIP_PUBLIC_URL>/.well-known/jwks.json
PAPERCLIP_JWKS_URL=
# Optional tuning. How long fetched keys are trusted before a refetch (default
# 600), the minimum gap between refetches for an unknown kid (default 30), and
# the clock skew tolerated on iat/exp (default 30).
# PAPERCLIP_JWKS_CACHE_SECONDS=600
# PAPERCLIP_JWKS_MIN_REFETCH_SECONDS=30
# PAPERCLIP_JWT_CLOCK_SKEW_SECONDS=30

# Shared with Paperclip. Signs every service call in both directions
# (lib/serviceSigning.js): x-nextgent-timestamp (unix seconds), x-nextgent-nonce
# (random, 16+ bytes hex, never reused) and x-nextgent-signature, the hex
# HMAC-SHA256 of
#   `${timestamp}\n${nonce}\n${METHOD}\n${pathname}\n${query}\n${sha256hex(body)}`
# so a signature is good for one request, on one route, once. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTGENT_SERVICE_SECRET=
# Where this API reaches Paperclip for receipts and conversations (CONTRACT §5).
PAPERCLIP_API_URL=
#
# One secret per purpose (lib/requiredSecrets.js). None of these is derived
# from NEXTGENT_SERVICE_SECRET or from each other, and a production deploy
# refuses to start with any of them missing. Generate each the same way.
#
# Encrypts stored secrets at rest (automation routine webhook secrets, Google
# OAuth tokens; lib/secretBox.js). Changing it makes stored ones unreadable;
# reinstalling the automation stores a fresh one.
NEXTGENT_SECRETS_KEY=
# Signs install session tokens (POST /api/nextgent/installs/:id/session,
# lib/businessTokens.js). Changing it only ends the sessions in flight.
NEXTGENT_SESSION_SECRET=
# Phone codes are an HMAC under VERIFY_CODE_SECRET: see PHONE CODES below.

# Optional. Pin a table to a permission resource (CONTRACT §6) when its name
# does not say which: JSON, table -> business|menu|availability|bookings|events|
# reviews|transactions|messages. Example: {"daily_specials":"menu"}
# BUSINESS_RESOURCE_TABLES=

# The forwarding address each business gets: <prefix><slug>@<domain>, read
# back by /api/email-parser/inbound. Without a domain, no address is issued.
INTAKE_EMAIL_DOMAIN=
# Optional. Defaults to the prefix routes/email-parser.js parses ("gcr-").
# INTAKE_EMAIL_PREFIX=

# Teardown export (POST /api/nextgent/unlink with export: true): the Supabase
# Storage bucket the JSON goes to (private), and how long its link works.
EXPORT_BUCKET=
EXPORT_URL_TTL_SECONDS=604800

# ═══════════════════════════════════════════════════════════════════════════
# TELEPHONY (CONTRACT §7) — lib/telephony
# ═══════════════════════════════════════════════════════════════════════════
#
# telnyx (default) or twilio (the legacy path). NOTE: with this unset, texts go
# through Telnyx; a deploy that only has Twilio keys must set twilio here.
TELEPHONY_PROVIDER=telnyx
# Telnyx: API key, the webhook public key (base64, Portal -> Keys), the
# messaging profile texts go out on, and the Call Control connection for voice.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
# The registered platform number: claim codes and owner notifications.
PLATFORM_NUMBER=
# The concierge's own number (inbound handled by the live voice/SMS handlers).
CONCIERGE_NUMBER=
# Optional. Spoken-message voice and language (Telnyx speak), default female /
# en-US; how many times a spoken message is read (default 2); the say webhook
# URL (default <API_BASE_URL>/api/telephony/telnyx/say); the webhook timestamp
# tolerance in seconds (default 300); the API host, only for a proxy/sandbox.
# TELNYX_TTS_VOICE=female
# TELNYX_TTS_LANGUAGE=en-US
# TELEPHONY_SAY_REPEATS=2
# TELNYX_SAY_WEBHOOK_URL=
# TELNYX_WEBHOOK_TOLERANCE_SECONDS=300
# TELNYX_API_URL=
# Optional. Country code for numbers typed without one (digits, default 1),
# and the country numbers are searched/bought in (default US).
# TELEPHONY_DEFAULT_COUNTRY_CODE=1
# TELEPHONY_NUMBER_COUNTRY=US
# Twilio (legacy, only when TELEPHONY_PROVIDER=twilio). TWILIO_WEBHOOK_BASE_URL
# is the public origin Twilio signs webhook URLs with.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_BASE_URL=
# TWILIO_API_URL=
# TWILIO_LOOKUP_URL=

# ═══════════════════════════════════════════════════════════════════════════
# CLAIMS — a code to the listing's phone (/api/claims)
# ═══════════════════════════════════════════════════════════════════════════
# The code itself is a phone code (lib/phoneVerification.js), so its secret,
# length, lifetime and tries are the VERIFY_* settings under PHONE CODES below.
# Renamed, set the new name if you had set the old one:
#   CLAIM_CODE_SECRET       -> VERIFY_CODE_SECRET
#   CLAIM_CODE_DIGITS       -> VERIFY_CODE_DIGITS
#   CLAIM_CODE_TTL_MINUTES  -> VERIFY_CODE_TTL_MINUTES
#   CLAIM_MAX_ATTEMPTS      -> VERIFY_MAX_ATTEMPTS
# Still claims' own: how many codes a company (or a listing) may be sent an hour.
# CLAIM_MAX_STARTS_PER_HOUR=5

# ═══════════════════════════════════════════════════════════════════════════
# OWNER NOTIFICATIONS — lib/notify.js
# ═══════════════════════════════════════════════════════════════════════════
# The owner app's address; notification links that are paths are joined to it.
OWNER_APP_URL=
# Optional. Paths in the owner app for the review queue and for billing.
# OWNER_REVIEW_PATH=
# OWNER_BILLING_PATH=
# Claims waiting for review are emailed here (also used by utils/email.js).
# PLATFORM_ADMIN_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════
# BILLING — store items, AI usage, Phone Agent numbers (lib/billingStripe.js)
# ═══════════════════════════════════════════════════════════════════════════
# The platform's Stripe account. Prices are rows (store_items.price_cents and
# stripe_price_id, billing_plan.stripe_price_id), never env or code.
STRIPE_SECRET_KEY=
# Point the Stripe webhook at /api/stripe/webhook with subscription and invoice
# events; unsigned events never change a subscription.
STRIPE_WEBHOOK_SECRET=
# Credits per US dollar of AI spend reported from LiteLLM (default 100, i.e.
# one credit per cent), and the billing_usage dimension plan limits meter them
# by (default ai_credits).
USAGE_CREDITS_PER_USD=100
# USAGE_CREDITS_DIMENSION=ai_credits
# Optional. A Stripe Billing meter event name; when set, credits added are
# reported to it so usage appears on the invoice.
# STRIPE_USAGE_METER_EVENT=
# The store item (store_items.key) whose price is a Phone Agent number's
# monthly charge. An install of this item, or any install whose manifest asks
# for the `telephony` capability, gets its own number (lib/phoneAgent.js).
PHONE_AGENT_NUMBER_ITEM_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# PHONE CODES — lib/phoneVerification.js, any carrier, the one copy
# ═══════════════════════════════════════════════════════════════════════════
# Used by tourist sign-in, business sign-up and sign-in (/api/business-auth)
# and listing claims (/api/claims). VERIFY_CODE_SECRET is the HMAC key stored
# codes are kept under: its own secret, required in production
# (lib/requiredSecrets.js). Optional: digits, lifetime in minutes and tries
# per code. The text may carry {code} and {minutes} (claims send their own
# wording, by text or an automated call).
#
# Business sign-up no longer uses Twilio Verify. Retired, remove when nothing
# else needs them: TWILIO_VERIFY_SERVICE_SID, and the platform_config rows
# twilio_account_sid / twilio_auth_token / twilio_verify_service_sid (they
# were only read by routes/business-auth.js).
VERIFY_CODE_SECRET=
# VERIFY_CODE_DIGITS=6
# VERIFY_CODE_TTL_MINUTES=10
# VERIFY_MAX_ATTEMPTS=5
# VERIFY_CODE_MESSAGE=Your verification code is {code}. It expires in {minutes} minutes.
# Optional. The word a QR-code text starts with (routes/sms.js /qr-codes),
# e.g. a campaign keyword; without it the text is the code alone.
# SMS_QR_KEYWORD=
# Optional. Where the daily update-link editor and the live-photo review page
# (review.html) are hosted (routes/update-link.js, routes/live-photo.js).
# Without it live-photo review requests are not texted.
# LINKS_BASE_URL=
# The passcode on a daily update link: how many digits, and how many wrong
# guesses before the link is locked (routes/update-link.js).
# UPDATE_LINK_PASSCODE_DIGITS=6
# UPDATE_LINK_PASSCODE_ATTEMPTS=5
# Inbound-parse domain for each business's forwarding address, and the part
# before the slug (default gcr-, the prefix every address handed out so far
# carries).
# INTAKE_EMAIL_PREFIX=

# ═══════════════════════════════════════════════════════════════════════════
# MESSAGES — messages.send (lib/messages.js, /api/business/messages)
# ═══════════════════════════════════════════════════════════════════════════
# The platform's own name: shown by the MCP server and used as {{brand}} in
# platform emails (templates/email, POST /api/nextgent/email — required there).
PLATFORM_NAME=
# Optional. Path in the owner app of the Messages screen; "waiting for your OK"
# notifications link to it (joined to OWNER_APP_URL).
# OWNER_MESSAGES_PATH=

# ═══════════════════════════════════════════════════════════════════════════
# AUTOMATIONS — waits, agents, business events (lib/automationEngine.js)
# ═══════════════════════════════════════════════════════════════════════════
# The time zone schedules and booking times are read in when neither the
# trigger nor the business names one (IANA name; default UTC).
DEFAULT_TIMEZONE=
# Optional. Longest wait a step may ask for, in minutes (unset = no limit);
# how long the "give to an agent" step waits for Paperclip (ms, default
# 10000); waits resumed and bookings completed per scheduled check (100/200).
# AUTOMATION_WAIT_MAX_MINUTES=
# AUTOMATION_AGENT_TIMEOUT_MS=10000
# AUTOMATION_RESUME_LIMIT=100
# BOOKING_COMPLETE_LIMIT=200
# Optional. A booking with a start time but no end time is over this many
# minutes after it starts; unset, it is over at the end of its day.
# BOOKING_DEFAULT_DURATION_MINUTES=
# Optional. Owner-app path that "an automation did not finish" links to.
# OWNER_AUTOMATIONS_PATH=

# ═══════════════════════════════════════════════════════════════════════════
# INTAKE AND THE OWNER APP (/api/owner, lib/intake.js, lib/payments.js)
# ═══════════════════════════════════════════════════════════════════════════
# Which emails are Gmail / Outlook forwarding confirmations is data
# (forwarding_confirmation_rules, sql/nextgent_intake.sql), not env.
# Currency for payments read from email that do not state one (ISO, e.g. usd).
DEFAULT_CURRENCY=
# Optional. Rows per owner list (bookings, payments; default 500), and more
# entity columns an owner may not change through PATCH /api/owner/profile
# (comma-separated; identity, listing, verification, billing and rating
# columns are always locked).
# OWNER_LIST_LIMIT=500
# OWNER_PROFILE_LOCKED_COLUMNS=

# ═══════════════════════════════════════════════════════════════════════════
# COMPUTERS — QR pairing and remote view (routes/nodes.js)
# ═══════════════════════════════════════════════════════════════════════════
# The owner-app page a pairing QR opens (?code=<user code> is added).
NODE_PAIR_URL=
# The remote-view link, with {node} and {token} filled in (GET /api/nodes/:id/remote).
NODE_REMOTE_URL_TEMPLATE=
# Optional. Pairing code lifetime (minutes, default 10), how often the
# computer should poll (seconds, 5), short-code length (8), the name a paired
# computer gets when it sent none (Computer), remote link lifetime (15 min).
# NODE_PAIR_TTL_MINUTES=10
# NODE_PAIR_POLL_SECONDS=5
# NODE_PAIR_CODE_LENGTH=8
# NODE_DEFAULT_NAME=Computer
# NODE_REMOTE_TTL_MINUTES=15
# Plan checkout (POST /api/billing/checkout) sends the owner back to
# OWNER_APP_URL + OWNER_BILLING_PATH; plans are rows (billing_plan.stripe_price_id).

# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE BUSINESS PROFILE PUSH (lib/googlePush.js, routes/google-business.js)
# ═══════════════════════════════════════════════════════════════════════════
# Google's per-profile edit limit (edits per minute per profile; Google
# publishes 10). Unset = nothing is pushed.
GOOGLE_EDITS_PER_MINUTE=
# Optional. Tries before a push is given up and the owner told (5), seconds
# between tries (300 x attempt), how often verification is re-checked (hours,
# 24), rows read per fact (500), pushes per drain (100).
# GOOGLE_PUSH_MAX_ATTEMPTS=5
# GOOGLE_PUSH_RETRY_SECONDS=300
# GOOGLE_VERIFY_RECHECK_HOURS=24
# GOOGLE_PUSH_ROW_LIMIT=500
# GOOGLE_PUSH_BATCH=100
# Optional. The menu's name and the section items without a category go in
# (both default Menu); a post's language (BCP 47) when Google should be told.
# GOOGLE_MENU_NAME=Menu
# GOOGLE_MENU_DEFAULT_SECTION=Menu
# GOOGLE_POST_LANGUAGE=
# Optional. Owner-app path a failed push links to.
# OWNER_GOOGLE_PATH=
# Optional. Google's API roots, only for a proxy or test double.
# GOOGLE_AUTH_URL= GOOGLE_USERINFO_URL= GOOGLE_TOKEN_URL= GOOGLE_GBP_ACCOUNTS_URL=
# GOOGLE_GBP_INFO_URL= GOOGLE_GBP_V4_URL= GOOGLE_GBP_VERIFICATIONS_URL=

# ═══════════════════════════════════════════════════════════════════════════
# LIVE CALLS AND TEXTS (routes/telephony-live.js) — ALWAYS-ON SERVER ONLY
# ═══════════════════════════════════════════════════════════════════════════
# Point the Telnyx messaging profile's inbound webhook at
# <API_BASE_URL>/api/telephony/telnyx/messaging and the Call Control
# connection's at <API_BASE_URL>/api/telephony/telnyx/voice. Every event must
# carry Telnyx's signature (TELNYX_PUBLIC_KEY above).
#
# LiteLLM (CONTRACT §8): the gateway, the master key (makes one key per
# company for its live calls, and reads spend), the NEXT GENT key the
# concierge runs on, and the models (no model is named in code). Without
# LITELLM_URL the single-key fallback answers without tools (dev only).
LITELLM_URL=
LITELLM_MASTER_KEY=
LITELLM_CONCIERGE_KEY=
LITELLM_MODEL=
# LITELLM_CONCIERGE_MODEL=
# The concierge's instructions (else the platform_config row
# concierge_instructions) and what it says on answering.
CONCIERGE_INSTRUCTIONS=
# CONCIERGE_GREETING=
# A Phone Agent's instructions come from its install; these are the fallback
# and the greeting (else the business's name is spoken).
# PHONE_AGENT_DEFAULT_INSTRUCTIONS=
# PHONE_AGENT_GREETING=
# Optional. What a reply to HELP says; what is said when the model gives
# nothing; minutes before a quiet text conversation is closed and recorded
# (30); tool rounds per turn (4); reply length (300 tokens); tool result size
# fed back (6000 chars); Telnyx transcription engine and language.
# SMS_HELP_REPLY=
# LIVE_FALLBACK_REPLY=
# LIVE_SMS_SESSION_MINUTES=30
# LIVE_MAX_TOOL_ROUNDS=4
# LIVE_MAX_TOKENS=300
# LIVE_TOOL_RESULT_CHARS=6000
# TELNYX_TRANSCRIPTION_ENGINE=
# TELNYX_TRANSCRIPTION_LANGUAGE=
#
# LiteLLM spend pulled per company into usage credits (lib/litellmUsage.js).
# ON by default: this pull is the billing path (Paperclip does not post usage).
# While it is on, the signed POST /api/nextgent/usage is refused (409
# usage_pull_on) so the same spend is never billed twice. Set false only if
# something else pushes usage instead.
# LITELLM_USAGE_PULL=true
# LITELLM_KEY_PAGE_SIZE=100
# LITELLM_KEY_MAX_PAGES=50

# ═══════════════════════════════════════════════════════════════════════════
# ALWAYS-ON SERVER (lib/scheduler.js)
# ═══════════════════════════════════════════════════════════════════════════
# true on the always-on server: the scheduled work runs in-process (ignored
# on Vercel, which uses vercel.json crons). Intervals in seconds.
# ALWAYS_ON=false
# SCHEDULER_AUTOMATIONS_SECONDS=60
# SCHEDULER_GOOGLE_PUSH_SECONDS=60
# SCHEDULER_LITELLM_USAGE_SECONDS=3600
# SCHEDULER_CONVERSATIONS_SECONDS=60

# ═══════════════════════════════════════════════════════════════════════════
# APP ENGINE APPS (routes/app-data.js, lib/appInstances.js)
# ═══════════════════════════════════════════════════════════════════════════
# Short-lived install tokens (POST /api/nextgent/installs/:id/session), in
# seconds; never more than 300 whatever is set here.
# INSTALL_SESSION_TTL_SECONDS=300
# Largest app manifest accepted on install, in bytes.
# APP_MANIFEST_MAX_BYTES=262144
# Rows an app's own table returns per page, the most it may hold per install,
# and the largest single record (bytes).
# APP_DATA_ROW_LIMIT=500
# APP_DATA_MAX_ROWS_PER_TABLE=5000
# APP_RECORD_MAX_BYTES=16384
# Public app blocks (GET/POST /api/public/apps/...): rows per source, cache
# seconds, and per-IP limits per window (submissions, reads).
# APP_PUBLIC_ROW_LIMIT=200
# APP_PUBLIC_CACHE_SECONDS=30
# APP_PUBLIC_RATE_WINDOW_SECONDS=60
# APP_PUBLIC_SUBMIT_RATE_LIMIT=10
# APP_PUBLIC_READ_RATE_LIMIT=120
