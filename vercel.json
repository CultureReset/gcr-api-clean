{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/platform/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/gcr/weather/refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/gcr/deep-crawl/run",
      "schedule": "*/30 * * * *"
    }
  ]
}
